# Railway Postgres connection string. Railway injects this automatically
# when the Postgres service is linked to this app service (reference it as
# ${{ Postgres.DATABASE_URL }} in the Railway service variables).
DATABASE_URL=

# Secret used to sign session cookies (replaces Supabase Auth). Generate one
# with: openssl rand -base64 48
SESSION_SECRET=

# Optional: trusted production origin used for social preview image metadata.
NEXT_PUBLIC_SITE_URL=

# Railway Bucket credentials. Link one private Bucket to the app service and
# reference the bucket-provided variables with these names.
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=auto
ENDPOINT=

# Set this only when the Bucket Credentials tab says the bucket uses legacy
# path-style URLs. New Railway buckets use virtual-hosted URLs.
S3_FORCE_PATH_STYLE=false
